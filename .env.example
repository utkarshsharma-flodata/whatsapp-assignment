# Copy this file to .env and fill in the values. Never commit .env.
# Changes to .env are picked up on the next message (no restart needed).

# UI
APP_TITLE=Lead Assistant

# Groq API: required for intent detection and entity extraction
GROQ_API_KEY=
# Exact Groq model identifier (e.g. the Qwen model enabled on your account)
GROQ_MODEL=
# 0 gives the most consistent extraction
GROQ_TEMPERATURE=0
# Customer replies: a little variety reads more naturally
GROQ_REPLY_TEMPERATURE=0.4
# For reasoning models such as Qwen3 set to "hidden" so only the JSON answer
# is returned. Leave blank for models that do not support reasoning_format.
GROQ_REASONING_FORMAT=hidden

# SQLite database (created automatically; relative to the project folder)
DATABASE_PATH=data/leads.db
# Added to 10-digit local phone numbers when matching returning customers
DEFAULT_COUNTRY_CODE=91

# Optional business details and prices the assistant may quote.
# Copy business_profile.example.json to business_profile.json and edit it.
# Without it, the assistant never states prices and says the team will confirm details.
BUSINESS_PROFILE_PATH=business_profile.json

# Logging (logs/app.log). Secrets and customer message text are never logged.
LOG_LEVEL=INFO
